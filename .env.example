DATABASE_URL=postgresql://postgres:postgres@localhost:5432/business_reality
API_KEY=
ENV=development

# LLM provider for the reasoning layer (Sections 28-30). One of: anthropic | openai | openai_compatible
LLM_PROVIDER=anthropic
LLM_MODEL=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# openai_compatible — any endpoint speaking the OpenAI chat completions API
# (Groq, Together, DeepSeek, local Ollama's /v1, etc). Both required if used.
LLM_API_KEY=
LLM_BASE_URL=

# Web search for questions your own data cannot answer (competitors, the market). tavily | brave. Blank key = off.
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

# Scheduler (Sections 17-18) — background detection cycle
SCHEDULER_ENABLED=true
DETECTION_INTERVAL_MINUTES=15

# Frontend CORS
CORS_ORIGINS=http://localhost:5173

# Connector credential encryption (SECURITY.md item 8) — required if any
# database connector is configured. Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=

# Per-tenant user auth (Section 48) — required for any register/login/JWT flow
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Separate admin credential for cross-tenant /api/system/* ops endpoints
# (SECURITY.md item 9). Deliberately fails closed (503) if unset. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# true = only businesses with an active licence can sign in (create the master account first; see README, Licences)
LICENCE_ENFORCED=false
# With enforcement on, a business on a paid licence is paused this many days after its paid period ends (or after
# activation, if it never paid). Paying, or a reinstate by the master account, restores access at once. 0 = no grace.
LICENCE_GRACE_DAYS=7
# The shared service key (API_KEY) may send events for any business. Unset = on in development, OFF in production.
# Prefer a business sign-in or a connector's webhook token; set true only for a trusted single-business install.
ALLOW_SERVICE_KEY_INGEST=

# DB connection pool sizing (Section 47/51 performance). Raise for
# higher concurrent load; each unit here is one real Postgres connection.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# Optional. Shared rate-limit counters + scheduler lock across workers/machines.
REDIS_URL=
# Number of trusted reverse-proxy hops for X-Forwarded-For (0 = ignore header).
TRUSTED_PROXY_HOPS=0

# --- docker compose (docker-compose.yml) ---
POSTGRES_USER=bre
POSTGRES_PASSWORD=
POSTGRES_DB=business_reality
WEB_CONCURRENCY=4
# Generate CONNECTOR_ENCRYPTION_KEY with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Rate limits per minute (defaults shown). General is per source IP; webhook per connector; auth per IP.
RATE_LIMIT_GENERAL_PER_MIN=300
RATE_LIMIT_WEBHOOK_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=10

# Seconds to cache dashboard KPIs (0 disables).
KPI_CACHE_TTL_SECONDS=30

# Alert delivery. Email needs SMTP_*; webhooks need nothing here.
APP_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@yourdomain.com
SMTP_STARTTLS=true
SMTP_SSL=false
# Dev/test only: allow http:// and private-IP webhook targets (disables the SSRF guard).
ALLOW_PRIVATE_WEBHOOK_TARGETS=false
# SMS / WhatsApp go through Twilio (https://www.twilio.com). Leave blank to disable those channel types.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=            # your Twilio number, E.164
TWILIO_WHATSAPP_FROM=       # your approved WhatsApp sender, E.164
# Slack and Teams use incoming-webhook URLs entered per channel in the app; nothing to set here.
# Forgot-password and email invitations use SMTP_* above and APP_BASE_URL for the links they contain.

# Account lockout (defaults shown)
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

# Connectors (Block C)
# Folder under which each business's shared folder / SQLite files live as <root>/<tenant_id>/... (unset = file-based connectors disabled)
CONNECTOR_FILE_ROOT=
# Connectors may not target private/internal addresses (use the local agent instead). Unset = ON when ENV=production,
# off in development. Set false only for a single-business install that must reach its own network.
BLOCK_PRIVATE_CONNECTOR_HOSTS=

# AI speed and reliability (optional). Seconds to wait for one AI call before trying the next provider (default 20),
# how long a provider that just failed is skipped (default 30), and how long an identical question's answer is reused (default 120).
# LLM_TIMEOUT_SECONDS=20
# LLM_FAILURE_COOLDOWN_SECONDS=30
# ASK_CACHE_SECONDS=120

# Local systems (smePro, Imara, Pharmacy ERP). API_PUBLIC_URL is the address the owner's computer reaches this API on
# (it goes inside the connection code; on Render it defaults to RENDER_EXTERNAL_URL). AGENT_DOWNLOAD_URL is where the
# one-file Windows agent (built by the "Windows agent" GitHub workflow) can be downloaded; the app shows it to owners.
API_PUBLIC_URL=
AGENT_DOWNLOAD_URL=
