# Environment variables for the Render web service (paste into Render -> Environment).
# Generate each secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Fernet key:                 python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Neon: DIRECT (non-pooled) connection string, ending in ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

ENV=production
RUN_MIGRATIONS=1
PORT=8000
WEB_CONCURRENCY=1
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
TRUSTED_PROXY_HOPS=1

# Fill after the Cloudflare Pages site exists (no trailing slash)
APP_BASE_URL=https://YOUR-PROJECT.pages.dev
CORS_ORIGINS=https://YOUR-PROJECT.pages.dev

API_KEY=
ADMIN_API_KEY=
# optional: lets your own CRM read the short alert feed of businesses that chose to share it (see docs/ECOSYSTEM.md). Leave empty to switch the feed off.
ADVISOR_FEED_KEY=
# true = only businesses with an active licence can sign in (create the master account first; see README, Licences)
LICENCE_ENFORCED=false
# days a paid licence may run past its paid period before it is paused (0 = none)
LICENCE_GRACE_DAYS=7
JWT_SECRET_KEY=
CONNECTOR_ENCRYPTION_KEY=

# Optional
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
