# Copy to .env on the server. Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Neon: use the DIRECT (non-pooled) connection string, ending in ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Public API hostname. No domain? Use  <server-ip-with-dashes>.sslip.io  e.g. 34-12-56-78.sslip.io
API_HOST=34-12-56-78.sslip.io
APP_BASE_URL=https://YOUR-PROJECT.pages.dev
CORS_ORIGINS=https://YOUR-PROJECT.pages.dev

API_KEY=
ADMIN_API_KEY=
# true = only businesses with an active licence can sign in (create the master account first; see README, Licences)
LICENCE_ENFORCED=false
JWT_SECRET_KEY=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional web search for the Ask box (tavily | brave)
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
# Optional email (password reset, invites, alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
